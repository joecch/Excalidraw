      "isDeleted": true,
      "boundElements": [],
      "updated": 1790463506135,
      "link": null,
      "locked": false,
      "text": "Let's take a look at this system of linear equations:\nOf course we know the point of intersection of these 2 lines is (1, 2)",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Let's take a look at this system of linear equations:\nOf course we know the point of intersection of these 2 lines is (1, 2)",
      "autoResize": true,
      "lineHeight": 1.25,
