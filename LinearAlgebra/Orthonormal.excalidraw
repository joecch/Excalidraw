    {
      "id": "5_TbuHo32pq_VcjhAn7s2",
      "type": "text",
      "x": 301.80992922076496,
      "y": 5201.501667377381,
      "width": 644.0790405273438,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
