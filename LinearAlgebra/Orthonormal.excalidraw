    {
      "id": "GnoxrgM6pMXOyPwhrRCAP",
      "type": "text",
      "x": 338.30024201193,
      "y": 7661.034666426393,
      "width": 930.5787353515625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4Z",
      "roundness": null,
      "seed": 630991515,
      "version": 497,
      "versionNonce": 696533437,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1790463506135,
      "link": null,
      "locked": false,
      "text": "Doing elimination on A to solve Ax = b is expensive especially when A getting larger and larger.\nBy decomposing A into LU where L is Lower Triangular Matrix and U is Upper Triangular Matrix that\nwill simplify the operations and save computation time if the same system (which means Ax) is re-used\nto solve another target (which means b) in the sense that we don't need to do the elimination again.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Doing elimination on A to solve Ax = b is expensive especially when A getting larger and larger.\nBy decomposing A into LU where L is Lower Triangular Matrix and U is Upper Triangular Matrix that\nwill simplify the operations and save computation time if the same system (which means Ax) is re-used\nto solve another target (which means b) in the sense that we don't need to do the elimination again.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "g_bAtGyXZAX2Cxzua8Dd5",
      "type": "text",
      "x": 345.0190225295081,
      "y": 8044.602469232356,
      "width": 391.67950439453125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4a",
      "roundness": null,
      "seed": 205633141,
      "version": 697,
      "versionNonce": 1361544339,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1790463506135,
      "link": null,
      "locked": false,
      "text": "Step 1: Solve Ly = b, forward substitution\nStep 2: Solve Ux = y, backward substitution",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 1: Solve Ly = b, forward substitution\nStep 2: Solve Ux = y, backward substitution",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
