    {
      "id": "tA1U1rMuVU89W15StdyfS",
      "type": "text",
      "x": 268.9280090332031,
      "y": 180.90711975097656,
      "width": 608.7791748046875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
