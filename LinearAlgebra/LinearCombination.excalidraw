    {
      "id": "Ad3Bfh8TFaEOlGf_6_BYx",
      "type": "text",
      "x": 291.1579400492306,
      "y": 4272.213645954186,
      "width": 243.79583740234375,
      "height": 35,
      "angle": 0,
