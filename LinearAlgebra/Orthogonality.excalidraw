    },
    {
      "id": "7lenVe5qCHB5bTai13VOP",
      "type": "text",
      "x": 238.3137826472677,
      "y": 2578.214485991499,
      "width": 1207.63818359375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2w",
      "roundness": null,
      "seed": 1801339667,
      "version": 419,
      "versionNonce": 1706654259,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785486461323,
      "link": null,
      "locked": false,
      "text": "Row Space of A, R(A), is orthogonal to Null Space of A, N(A), given taking dot product on every row in A with x results in zero so that \nfor all combination of R(A), their dot product for N(A) is zero",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Row Space of A, R(A), is orthogonal to Null Space of A, N(A), given taking dot product on every row in A with x results in zero so that \nfor all combination of R(A), their dot product for N(A) is zero",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VWO5cT95UOmgv0YjYIXSO",
      "type": "text",
      "x": 248.8114898108809,
      "y": 3439.4241540959124,
