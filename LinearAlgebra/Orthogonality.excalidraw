      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2wV",
      "roundness": null,
      "seed": 1531718333,
      "version": 565,
      "versionNonce": 1176581373,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785486503334,
      "link": null,
      "locked": false,
      "text": "Similarly, column space of A is orthogonal to left null space ",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Similarly, column space of A is orthogonal to left null space ",
      "autoResize": true,
      "lineHeight": 1.25
    },
