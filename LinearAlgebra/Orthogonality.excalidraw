      "updated": 1785485453925,
      "link": null,
      "locked": false,
      "text": "Orthogonal relationship between 4 spaces",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Orthogonal relationship between 4 spaces",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2VGNQiAm0w2L4V_Do7DyG",
      "type": "text",
      "x": 243.5460205078125,
      "y": 223.27259826660156,
      "width": 537.83935546875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2b",
      "roundness": null,
      "seed": 1249588957,
      "version": 172,
      "versionNonce": 1120094717,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785483617153,
      "link": null,
      "locked": false,
      "text": "If two vectors are orthogonal, their dot product will be zero.\nLet's take Unit vectors x and y as an example:",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If two vectors are orthogonal, their dot product will be zero.\nLet's take Unit vectors x and y as an example:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dCAXoe9LACoMZWYJ-wE3H",
      "type": "text",
      "x": 241.18923950195312,
      "y": 645.6250762939453,
      "width": 399.6194763183594,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2bV",
      "roundness": null,
      "seed": 408239987,
      "version": 324,
      "versionNonce": 1463787197,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785484733803,
      "link": null,
      "locked": false,
      "text": "We can interpret it in geometry way as well:",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We can interpret it in geometry way as well:",
      "autoResize": true,
      "lineHeight": 1.25
    },
