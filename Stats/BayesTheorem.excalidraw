    {
      "id": "VTLD-ClcWkyphnjCt7GA8",
      "type": "text",
      "x": 246.70764978107422,
      "y": 1077.4794942870706,
      "width": 600.3795166015625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 1324701360,
      "version": 170,
      "versionNonce": 604840624,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773400414955,
      "link": null,
      "locked": false,
      "text": "The dataset is binary (i.e. only 2 classes): Librarian & Farmer\nWe denote Librarian as H and so Farmer is negation of H",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The dataset is binary (i.e. only 2 classes): Librarian & Farmer\nWe denote Librarian as H and so Farmer is negation of H",
      "autoResize": true,
      "lineHeight": 1.25
    },
