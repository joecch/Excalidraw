    {
      "id": "AgP8U-rtDyPjBrYbIHZ1-",
      "type": "text",
      "x": 246.54448513037465,
      "y": 1683.8668824931058,
      "width": 878.0794067382812,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 251677776,
      "version": 508,
      "versionNonce": 2110705232,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773400879718,
      "link": null,
      "locked": false,
      "text": "Note the denominator is the sum of \n1. The portion of H having evidence in H's domain\n2. The portion of negation of H having evidence in negation of H's domain\n\nSo it's altogether equivalent to portion of all having evidence in the entire popution: P(E)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note the denominator is the sum of \n1. The portion of H having evidence in H's domain\n2. The portion of negation of H having evidence in negation of H's domain\n\nSo it's altogether equivalent to portion of all having evidence in the entire popution: P(E)",
      "autoResize": true,
      "lineHeight": 1.25
    },
