      "isDeleted": false,
      "boundElements": null,
      "updated": 1773398955879,
      "link": null,
      "locked": false,
      "text": "In fact, the ratio of Librarian to Farmer in a country, says US, is 1:20.\nLet's the population of the data has 10 Librarians and 200 Farmers and\n4 Librarians and 20 Farmers have the evidence.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In fact, the ratio of Librarian to Farmer in a country, says US, is 1:20.\nLet's the population of the data has 10 Librarians and 200 Farmers and\n4 Librarians and 20 Farmers have the evidence.",
      "autoResize": true,
      "lineHeight": 1.25
    },
